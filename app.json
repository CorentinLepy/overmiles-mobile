{
  "expo": {
    "name": "OVERMILES",
    "slug": "overmiles-mobile",
    "scheme": "overmiles",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.overmiles.mobile"
    },
    "android": {
      "package": "app.overmiles.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4EBDD"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F4EBDD",
          "dark": {
            "backgroundColor": "#111A18"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
